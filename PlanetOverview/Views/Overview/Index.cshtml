@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planet Overview</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/news.css" asp-append-version="true">
</head>
<body class="bg-slate-50 font-sans text-slate-800">

    <!-- Navegação -->
    <nav class="bg-[#001f3f] text-white p-4 flex justify-between items-center px-10">
        <div class="flex items-center gap-2 text-xl font-bold">
            <i class="fas fa-globe"></i> Planet Overview
        </div>
        <div class="gap-6 text-sm hidden md:flex">
            <a href="#" class="border-b-2 border-white pb-1">Início</a>
            <a href="#como-funciona" class="text-slate-300 hover:text-white">Como funciona</a>
        </div>
    </nav>

    <!-- Cabeçalho / Busca -->
    <header class="max-w-5xl mx-auto mt-12 px-6 flex flex-col md:flex-row items-center justify-between">
        <div class="w-full md:w-1/2">
            <h1 class="text-4xl font-extrabold text-[#001f3f] mb-2">Descubra o mundo em um só lugar</h1>
            <p class="text-slate-500 mb-6">Pesquise qualquer país e veja informações atualizadas em uma única tela.</p>
            
            <form id="country-search" class="flex w-full shadow-sm rounded-lg overflow-hidden border border-slate-200 bg-white">
                <div class="p-3 text-slate-400 bg-white flex items-center justify-center">
                    <i class="fas fa-search"></i>
                </div>
                <input id="country-input" aria-label="País" required maxlength="100" value="Brasil" type="text" placeholder="Digite ou selecione um país..." class="w-full min-w-0 p-3 outline-none text-slate-700">
                <button id="search-button" type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 sm:px-6 shrink-0 whitespace-nowrap transition-colors">Buscar país</button>
            </form>
            <p id="country-source" class="mt-3 text-xs text-slate-500"></p>
            <p id="search-status" role="status" aria-live="polite" class="mt-3 text-sm text-slate-600"></p>
            
            <div class="mt-4 flex items-center text-xs text-slate-500 bg-green-50 w-fit px-3 py-1 rounded-full border border-green-100">
                <div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div> Consulta às APIs em tempo real
            </div>
        </div>
    </header>

    <!-- Card de Visão Geral (Usando os dados do C#!) -->
    <main id="overview" aria-busy="false" class="max-w-5xl mx-auto mt-12 px-6 mb-20">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
            
            <!-- Título do Card -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 border-b border-slate-100 pb-4">
                <div class="flex items-center gap-4">
                    <img id="country-flag" hidden alt="Bandeira do país" class="w-12 h-8 rounded shadow-sm border border-slate-100">
                    <h2 class="text-2xl font-bold text-[#001f3f]" id="country-title">Visão geral</h2>
                </div>
                <div class="text-sm text-slate-400 flex items-center gap-2">
                    <i class="fas fa-sync-alt"></i> <span id="updated-at">Aguardando consulta</span>
                </div>
            </div>

            <!-- Grid de Informações -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                
                <!-- Capital -->
                <div class="col-span-1 lg:col-span-2 bg-slate-50 rounded-xl p-6 border border-slate-100 flex items-center gap-4">
                    <i class="fas fa-landmark text-3xl text-slate-400"></i>
                    <div>
                        <p class="text-sm text-slate-500">Capital:</p>
                        <p class="text-xl font-bold"><span id="capital">—</span></p>
                    </div>
                </div>

                <!-- Idioma -->
                <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 flex items-center gap-4">
                    <i class="far fa-comment-dots text-3xl text-blue-500"></i>
                    <div>
                        <p class="text-sm text-slate-500">Idioma</p>
                        <p class="font-bold"><span id="language">—</span></p>
                    </div>
                </div>

                <!-- População -->
                <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 flex items-center gap-4">
                    <i class="fas fa-users text-3xl text-slate-400"></i>
                    <div>
                        <p class="text-sm text-slate-500">População</p>
                        <p class="font-bold"><span id="population">—</span></p>
                    </div>
                </div>

                <!-- Clima -->
                <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 flex items-center gap-4">
                    <i class="fas fa-cloud-sun text-3xl text-slate-400"></i>
                    <div>
                        <p class="text-sm text-slate-500">Clima agora</p>
                        <p class="text-xl font-bold"><span id="weather">—</span><small id="weather-description" class="block text-sm font-normal"></small></p>
                    </div>
                </div>

                <!-- Horário -->
                <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 flex items-center gap-4">
                    <i class="far fa-clock text-3xl text-blue-500"></i>
                    <div>
                        <p class="text-sm text-slate-500">Horário na capital</p>
                        <p class="text-xl font-bold"><span id="local-time">—</span><small id="time-zone" class="block text-sm font-normal"></small></p>
                    </div>
                </div>

                <!-- Conversor -->
                <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 flex items-center gap-4">
                    <i class="fas fa-exchange-alt text-3xl text-green-500"></i>
                    <div>
                        <p class="text-sm text-slate-500">Conversor de moeda</p>
                        <p class="font-bold"><span id="currency-rate">—</span></p>
                        <label for="currency-amount" class="block text-sm mt-2">Valor em USD</label>
                        <input id="currency-amount" type="number" min="0" step="0.01" value="1" class="w-full border rounded p-2" />
                        <output id="currency-result" for="currency-amount" class="block text-sm mt-2"></output>
                    </div>
                </div>

                <!-- Notícia -->
                <div class="bg-slate-50 rounded-xl p-6 border border-slate-100 flex items-center gap-4">
                    <i class="far fa-newspaper text-3xl text-slate-400"></i>
                    <div>
                        <p class="text-sm text-slate-500">Notícia em destaque</p>
                        <p id="news-status" class="text-sm">Aguardando consulta</p>
                    </div>
                </div>

            </div>
        </div>
        <section id="country-news" class="news-section" aria-labelledby="news-heading" aria-busy="false">
            <div class="news-section-heading">
                <div>
                    <p class="news-eyebrow"><span></span> O MUNDO EM PAUTA</p>
                    <h2 id="news-heading">Notícias do país</h2>
                    <p id="news-context" class="news-context">As manchetes acompanham o país que você pesquisar.</p>
                </div>
                <span id="news-count" class="news-count" hidden></span>
            </div>
            <div id="news-list" class="news-grid"></div>
        </section>
        <section id="como-funciona" class="mt-8 text-sm text-slate-500">
            <h2 class="font-bold">Como funciona</h2>
            <p>Busque um país em português ou inglês. Os dados gerais vêm de uma base local de referência do REST Countries e não são atualizados em tempo real. O painel consulta clima e horário da capital, câmbio com base em USD e notícias relacionadas ao país. Cada serviço pode ter disponibilidade e frequência de atualização diferentes.</p>
        </section>
    </main>

    <!-- Rodapé -->
    <footer class="bg-[#001f3f] text-center text-slate-400 py-6 text-sm">
        <i class="fas fa-globe mr-2"></i> Planet Overview — explore, compare e planeje
    </footer>


    <script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
